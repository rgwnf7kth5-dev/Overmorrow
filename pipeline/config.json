{
  "timezone": "Europe/Paris",
  "approval_required_through": "2026-10-23",
  "approval_note": "Morning runs on or before this date open a pull request that goes live when the publisher merges it. Later runs publish to main by 06:00 themselves.",
  "probability_min": 0.03,
  "probability_max": 0.97,
  "candidate_pool_min": 40,
  "stories_min": 12,
  "stories_max": 18,
  "ensemble_disagreement_limit": 0.25,
  "market_departure_flag": 0.15,
  "calibration_min_resolved": 50,
  "excluded_topics": [
    "sport",
    "financial market prices"
  ],
  "cz_stories_min": 6,
  "ensemble_roles": [
    "base-rate",
    "evidence",
    "adversarial",
    "anchor",
    "outsider"
  ],
  "extreme_share_max": 0.25,
  "extreme_below": 0.1,
  "extreme_above": 0.9,
  "weighting_min_resolved": 120,
  "weighting_shrink": 150,
  "calibration_prior_strength": 4,
  "extremize_max": 2.5,
  "ensemble_models": {
    "base-rate": "opus",
    "evidence": "opus",
    "adversarial": "fable",
    "anchor": "opus",
    "outsider": "sonnet"
  },
  "contested_min": 3,
  "contested_band": [
    0.3,
    0.7
  ],
  "interval_claims_max": 3,
  "new_rules_from": 4,
  "method_versions": [
    {
      "version": 1,
      "from": 1,
      "date": "2026-10-21",
      "label": "Pilot and early editions: forecasts without a structured record of the forecasters"
    },
    {
      "version": 2,
      "from": 4,
      "date": "2026-10-23",
      "label": "Five recorded forecasters, slip classes, interval claims, quotas on probability bands"
    },
    {
      "version": 3,
      "from": 5,
      "date": "2026-10-24",
      "label": "Event window and evidence time, full record of forecasting steps (blind and after-market estimates), numbers derived from one distribution, no quotas on probabilities, coverage of missed events"
    },
    {
      "version": 4,
      "from": 6,
      "date": "2026-10-25",
      "label": "Selection by news value: the biggest running stories of the day must be covered with a claim on their next step; economy desk with a minimum; photographs in every edition"
    }
  ],
  "v3": {
    "probability_min": 0.01,
    "probability_max": 0.99,
    "coherence_tolerance": 0.03,
    "watch_tolerance": 0.05,
    "revision_min_pp": 0.05,
    "revision_min_logit": 0.5,
    "decomposition_tolerance": 0.02,
